{
  "name": "designaanvraag",
  "private": true,
  "version": "0.1.0",
  "description": "NBC designaanvraag-tool: Typeform-achtig formulier \u2192 Asana-taak voor de designer, met automatische huisstijl-extractie.",
  "workspaces": [
    "shared",
    "web",
    "worker"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w web",
    "test": "npm run test -w web",
